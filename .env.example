# Server-only. Use isolated development/preview databases. Never commit populated files.
DATABASE_URL=
MIGRATION_DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
ABUSE_HASH_SECRET=
MAINTENANCE_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Vercel sends this as the Bearer secret to scheduled GET requests.
# Use the same value for CRON_SECRET and MAINTENANCE_SECRET on Vercel.
CRON_SECRET=

# Optional, server-only usage monitoring. Never use NEXT_PUBLIC_ for these.
NEON_MONITORING_API_KEY=
VERCEL_MONITORING_TOKEN=

# Optional official public MedStash footer contacts. Do not use personal or seller details.
MEDSTASH_CONTACT_EMAIL=
MEDSTASH_CONTACT_PHONE=
MEDSTASH_INSTAGRAM_URL=
MEDSTASH_TIKTOK_URL=
MEDSTASH_X_URL=
